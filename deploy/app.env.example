# Travel OS 后端环境变量模板
# 部署到服务器时放在 /opt/travel-os/.env（权限 600），所有值必须替换为真实值，严禁提交真实值到仓库

APP_PORT=3000

# PostgreSQL（服务器上由 Docker 容器 travel-os-postgres 提供）
DATABASE_URL=postgresql://travel_os:<数据库密码>@127.0.0.1:5432/travel_os

# 认证
JWT_SECRET=<随机长字符串，至少 48 字节>
AUTH_COOKIE_NAME=access_token

# 种子管理员（首次启动时创建）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=Admin
SEED_ADMIN_PASSWORD=<初始管理员密码>

# Redis（服务器原生 Redis，本机地址）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 高德地图（可选）
AMAP_WEB_SERVICE_KEY=
