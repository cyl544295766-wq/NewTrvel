# Travel OS 后端环境变量模板
# 部署到服务器时放在 /opt/travel-os/.env（权限 600），所有值必须替换为真实值，严禁提交真实值到仓库

APP_PORT=3000

# PostgreSQL（服务器上由 Docker 容器 travel-os-postgres 提供）
DATABASE_URL=postgresql://travel_os:<数据库密码>@127.0.0.1:5432/travel_os

# 认证
JWT_SECRET=<随机长字符串，至少 48 字节>
AUTH_COOKIE_NAME=access_token

# 种子管理员（首次启动时创建）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=Admin
SEED_ADMIN_PASSWORD=<初始管理员密码>

# 高德地图「Web服务」类型 Key（可选；仅地点联想 /api/places/suggestions 依赖它）
# 注意：页面地图展示用的是 Web端(JS API) 类型 Key，配置在前端 apps/web/assets/js/amap.js，
# 与本变量用途不同，两者不可互换（服务类型不匹配会返回 USERKEY_PLAT_NOMATCH）
AMAP_WEB_SERVICE_KEY=

# AI 旅行助手（OpenAI 兼容协议；三项均配置后才启用，任一为空则功能自动降级）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Cookie 安全（P2-2）：生产为 HTTPS 时必须置 true，登录令牌 Cookie 仅经加密连接传输
AUTH_SECURE_COOKIE=true

# 跨域白名单（P2-2）：逗号分隔的来源；前端与 API 同源部署时留空即可（默认仅同源）
# 例：CORS_ALLOWED_ORIGINS=https://travel.example.com,https://www.travel.example.com
CORS_ALLOWED_ORIGINS=
