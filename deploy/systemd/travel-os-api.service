[Unit]
Description=Travel OS API (Spring Boot)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/travel-os
# 发布版本标识（TRAVELOS_RELEASE_ID）：publish.sh 在每次切换时原子重写 /opt/travel-os/release.env，
# restart 后新进程读入；/api/health 的 release 字段即来自它，用于「运行版本 == 目标版本」核验。
# 前导 - 表示文件不存在（首次部署前）不报错。
EnvironmentFile=-/opt/travel-os/release.env
ExecStart=/usr/bin/java -jar /opt/travel-os/travel-os-api.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
